{
  "name": "kalfa",
  "version": "0.0.0",
  "description": "A method and a toolset for working with coding agents across many projects.",
  "type": "module",
  "private": true,
  "bin": {
    "kalfa": "dist/kalfa.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc",
    "test": "node --test 'test/**/*.test.ts'",
    "smoke": "node dist/kalfa.mjs doctor --smoke"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "tinyglobby": "0.2.17",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
